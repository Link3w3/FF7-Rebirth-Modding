@echo off
title Vincent as in Dirge of Cerberus, Create a Character System 3.7.0 - installing, please leave this window open
rem Installs (close the game first; takes a minute or two, most of it the mod's build):
rem   1. the paks into ~mods: FullyPlayableVincentAssets_P with Square as his Dirge of Cerberus melee combo (the installed
rem      one is copied to Tools\_backup\shooter1016\mods first), VincentDirgeMotions_P (his Dirge of Cerberus aim, shot,
rem      reload and switch motions for the three guns) and VincentChaos_P (Chaos's model and motions, for the CHAOS form),
rem   2. VincentDirge.json (the shooter's settings: controls, camera, HUD, guns) and the new Vincent_Moves.json (Square's
rem      melee combo) into the compat folder, and the HUD's pictures (Dirge of Cerberus' reticles, scope and bullet counter)
rem      into the mod's dirge_ui folder,
rem   3. builds the Create a Character System game mod 3.7.0 (main.dll, installed into the game): the shooter, and packs
rem      CreateACharacterSystem-Setup-3.7.0.exe into Tools\Share (its build script now compiles with /bigobj: 3.7's source
rem      is past the object format's section limit).
rem Everything it replaces is copied to Tools\_backup\shooter1016 first; every file is checked (md5).
rem (The pictures carry a content-credentials chunk the transfer added: their pixels are the sprites' own.)
rem Status: build\install_status.txt
setlocal
cd /d "%~dp0"
if not exist build mkdir build
set "STATUS=%~dp0build\install_status.txt"
set "STAGE=C:\FF7R2UProj\Tools\_stage\shooter1016"
set "GAME=C:\Program Files (x86)\Steam\steamapps\common\FINAL FANTASY VII REBIRTH"
set "MODS=%GAME%\End\Content\Paks\~mods"
set "MODDIR=%GAME%\End\Binaries\Win64\ue4ss\Mods\RebirthSkelCompat"
set "COMPAT=%MODDIR%\compat"
set "UI=%MODDIR%\dirge_ui"
set "SC=C:\FF7R2UProj\Tools\RebirthSkelCompat"
set "BACKUP=C:\FF7R2UProj\Tools\_backup\shooter1016"
set "VP=FullyPlayableVincentAssets_P"
echo Vincent shooter / Create a Character System 3.7.0 install started %DATE% %TIME%> "%STATUS%"
for %%P in (ff7rebirth_.exe ff7rebirth.exe) do (
  tasklist /FI "IMAGENAME eq %%P" 2>nul | find /I "%%P" >nul
  if not errorlevel 1 (
    echo REFUSED: close %%P first ^(the game^), then run this again>> "%STATUS%"
    goto :done
  )
)
if not exist "%MODS%\%VP%.utoc" goto :nomods
if not exist "%COMPAT%" goto :nocompat
if not exist "%SC%\build_dll.py" goto :nosource

rem ---- Chaos's container comes in three parts (it is bigger than a file the session can send): one file again
call :quietmd5 "%STAGE%\paks\VincentChaos_P.ucas" e2abbfb3e818d58fe03fe2ab89f58434 && goto :joined
echo joining VincentChaos_P.ucas from its three parts...>> "%STATUS%"
call :md5 "%STAGE%\paks\VincentChaos_P.ucas.000" 153908b3af3ad9169cbc826f364a11e0 || goto :badstage
call :md5 "%STAGE%\paks\VincentChaos_P.ucas.001" 6c755877f411a6a23421bc7a928bb758 || goto :badstage
call :md5 "%STAGE%\paks\VincentChaos_P.ucas.002" c648abd39e8ed71191b7e5da77c32bbd || goto :badstage
copy /b "%STAGE%\paks\VincentChaos_P.ucas.000"+"%STAGE%\paks\VincentChaos_P.ucas.001"+"%STAGE%\paks\VincentChaos_P.ucas.002" "%STAGE%\paks\VincentChaos_P.ucas" >nul
:joined
echo checking the files to install...>> "%STATUS%"
call :md5 "%STAGE%\paks\%VP%.ucas" e8e19b57f1a7b019e7353d0676b6bd41 || goto :badstage
call :md5 "%STAGE%\paks\%VP%.utoc" 55fa8e60a7e9fb159523c572a76fd68e || goto :badstage
call :md5 "%STAGE%\paks\%VP%.pak" 978275e5395574cf363603d330e50a28 || goto :badstage
call :md5 "%STAGE%\paks\VincentDirgeMotions_P.ucas" 4f681bd7c57aca8c42eb0abbcd99efba || goto :badstage
call :md5 "%STAGE%\paks\VincentDirgeMotions_P.utoc" 46f87cd83c8fc3d3ce1cfa4bb1614833 || goto :badstage
call :md5 "%STAGE%\paks\VincentDirgeMotions_P.pak" 116686b532f70dab3a126613cd0227c5 || goto :badstage
call :md5 "%STAGE%\paks\VincentChaos_P.ucas" e2abbfb3e818d58fe03fe2ab89f58434 || goto :badstage
call :md5 "%STAGE%\paks\VincentChaos_P.utoc" 9f666a934e60fc253a10d88af692fbdb || goto :badstage
call :md5 "%STAGE%\paks\VincentChaos_P.pak" 9a1a94be763fa980eac83fc59d90a6ee || goto :badstage
call :md5 "%STAGE%\compat\VincentDirge.json" 6349c377d9f1392583f5fa62c1da8f26 || goto :badstage
call :md5 "%STAGE%\compat\Vincent_Moves.json" 71edafed704064f70bb60561776170f6 || goto :badstage
call :pictures "%STAGE%\dirge_ui" || goto :badstage
call :md5 "%STAGE%\src\RebirthSkelCompat.cpp" c26ed7e6aacac0598face2e2406e52e0 || goto :badstage
call :md5 "%STAGE%\src\SkelCompatCore.hpp" 441e0548855b5f05afd0b8a473960c1f || goto :badstage
call :md5 "%STAGE%\mod\README.txt" 9c5e079dd87a9276814ce7da302a626b || goto :badstage
call :md5 "%STAGE%\mod\compat\example.json.txt" 04f6852a3b6f4f8888508390e437f118 || goto :badstage
call :md5 "%STAGE%\build_dll.py" e3ff1c3bfce270d88e47239076c1fce2 || goto :badstage
echo    all 32 as made>> "%STATUS%"

rem ---- 1. the paks (FullyPlayableVincentAssets_P made on the one in ~mods)
set "PAKSTEP=install"
call :quietmd5 "%MODS%\%VP%.utoc" 55fa8e60a7e9fb159523c572a76fd68e && call :quietmd5 "%MODS%\%VP%.ucas" e8e19b57f1a7b019e7353d0676b6bd41 && set "PAKSTEP=done"
if "%PAKSTEP%"=="done" goto :vincentdone
call :md5 "%MODS%\%VP%.utoc" 3a7540d53508e33f749874db22fa5fcc || goto :otherpak
call :md5 "%MODS%\%VP%.ucas" 2b78f8928034f94f9a1a5035e93dc44f || goto :otherpak
echo 1/3 installing the paks into ~mods ^(the old %VP% copied to Tools\_backup\shooter1016\mods^)...>> "%STATUS%"
if not exist "%BACKUP%\mods" mkdir "%BACKUP%\mods"
for %%E in (ucas utoc pak) do (
  if not exist "%BACKUP%\mods\%VP%.%%E" copy /y "%MODS%\%VP%.%%E" "%BACKUP%\mods\%VP%.%%E" >nul
)
call :md5 "%BACKUP%\mods\%VP%.utoc" 3a7540d53508e33f749874db22fa5fcc || goto :badbackup
call :md5 "%BACKUP%\mods\%VP%.ucas" 2b78f8928034f94f9a1a5035e93dc44f || goto :badbackup
call :md5 "%BACKUP%\mods\%VP%.pak" 978275e5395574cf363603d330e50a28 || goto :badbackup
for %%E in (ucas utoc pak) do copy /y "%STAGE%\paks\%VP%.%%E" "%MODS%\%VP%.%%E" >nul
call :md5 "%MODS%\%VP%.ucas" e8e19b57f1a7b019e7353d0676b6bd41 || goto :badpak
call :md5 "%MODS%\%VP%.utoc" 55fa8e60a7e9fb159523c572a76fd68e || goto :badpak
call :md5 "%MODS%\%VP%.pak" 978275e5395574cf363603d330e50a28 || goto :badpak
goto :motions
:vincentdone
echo 1/3 %VP% in ~mods is the new one already; installing the other two paks...>> "%STATUS%"
:motions
if not exist "%BACKUP%\mods" mkdir "%BACKUP%\mods"
for %%N in (VincentDirgeMotions_P VincentChaos_P) do (
  for %%E in (ucas utoc pak) do (
    if exist "%MODS%\%%N.%%E" if not exist "%BACKUP%\mods\%%N.%%E" copy /y "%MODS%\%%N.%%E" "%BACKUP%\mods\%%N.%%E" >nul
    copy /y "%STAGE%\paks\%%N.%%E" "%MODS%\%%N.%%E" >nul
  )
)
call :md5 "%MODS%\VincentDirgeMotions_P.ucas" 4f681bd7c57aca8c42eb0abbcd99efba || goto :badpak2
call :md5 "%MODS%\VincentDirgeMotions_P.utoc" 46f87cd83c8fc3d3ce1cfa4bb1614833 || goto :badpak2
call :md5 "%MODS%\VincentDirgeMotions_P.pak" 116686b532f70dab3a126613cd0227c5 || goto :badpak2
call :md5 "%MODS%\VincentChaos_P.ucas" e2abbfb3e818d58fe03fe2ab89f58434 || goto :badpak2
call :md5 "%MODS%\VincentChaos_P.utoc" 9f666a934e60fc253a10d88af692fbdb || goto :badpak2
call :md5 "%MODS%\VincentChaos_P.pak" 9a1a94be763fa980eac83fc59d90a6ee || goto :badpak2
echo    the three paks installed and checked>> "%STATUS%"

rem ---- 2. the compat files and the HUD's pictures
echo 2/3 installing VincentDirge.json and Vincent_Moves.json into the compat folder, the HUD's pictures into dirge_ui...>> "%STATUS%"
if not exist "%BACKUP%\compat" mkdir "%BACKUP%\compat"
for %%J in (VincentDirge.json Vincent_Moves.json) do (
  if exist "%COMPAT%\%%J" if not exist "%BACKUP%\compat\%%J" copy /y "%COMPAT%\%%J" "%BACKUP%\compat\%%J" >nul
  copy /y "%STAGE%\compat\%%J" "%COMPAT%\%%J" >nul
)
call :md5 "%COMPAT%\VincentDirge.json" 6349c377d9f1392583f5fa62c1da8f26 || goto :badjson
call :md5 "%COMPAT%\Vincent_Moves.json" 71edafed704064f70bb60561776170f6 || goto :badjson
if not exist "%UI%" mkdir "%UI%"
copy /y "%STAGE%\dirge_ui\*.png" "%UI%\" >nul
call :pictures "%UI%" || goto :badjson
echo    the two compat files and the 16 pictures installed and checked>> "%STATUS%"

rem ---- 3. the game mod 3.7.0
echo 3/3 building the Create a Character System game mod 3.7.0 ^(main.dll, installed into the game^)...>> "%STATUS%"
if not exist "%BACKUP%\src" mkdir "%BACKUP%\src"
if not exist "%BACKUP%\src\RebirthSkelCompat.cpp" copy /y "%SC%\src\RebirthSkelCompat.cpp" "%BACKUP%\src\RebirthSkelCompat.cpp" >nul
if not exist "%BACKUP%\src\SkelCompatCore.hpp" copy /y "%SC%\src\SkelCompatCore.hpp" "%BACKUP%\src\SkelCompatCore.hpp" >nul
if not exist "%BACKUP%\src\README.txt" copy /y "%SC%\mod\README.txt" "%BACKUP%\src\README.txt" >nul
if not exist "%BACKUP%\src\example.json.txt" copy /y "%SC%\mod\compat\example.json.txt" "%BACKUP%\src\example.json.txt" >nul
if not exist "%BACKUP%\src\build_dll.py" copy /y "%SC%\build_dll.py" "%BACKUP%\src\build_dll.py" >nul
copy /y "%STAGE%\src\RebirthSkelCompat.cpp" "%SC%\src\RebirthSkelCompat.cpp" >nul
copy /y "%STAGE%\src\SkelCompatCore.hpp" "%SC%\src\SkelCompatCore.hpp" >nul
copy /y "%STAGE%\mod\README.txt" "%SC%\mod\README.txt" >nul
copy /y "%STAGE%\mod\compat\example.json.txt" "%SC%\mod\compat\example.json.txt" >nul
copy /y "%STAGE%\build_dll.py" "%SC%\build_dll.py" >nul
call :md5 "%SC%\src\RebirthSkelCompat.cpp" c26ed7e6aacac0598face2e2406e52e0 || goto :badsource
call :md5 "%SC%\src\SkelCompatCore.hpp" 441e0548855b5f05afd0b8a473960c1f || goto :badsource
call :md5 "%SC%\mod\README.txt" 9c5e079dd87a9276814ce7da302a626b || goto :badsource
call :md5 "%SC%\mod\compat\example.json.txt" 04f6852a3b6f4f8888508390e437f118 || goto :badsource
call :md5 "%SC%\build_dll.py" e3ff1c3bfce270d88e47239076c1fce2 || goto :badsource
call :findpython
%PY% "%SC%\build_dll.py" --install > "%~dp0build\install_dll.log" 2>&1
if errorlevel 1 goto :badbuild
echo    game mod 3.7.0 built and installed>> "%STATUS%"
set "LATEST="
if exist "%SC%\build\latest.txt" set /p LATEST=<"%SC%\build\latest.txt"
%PY% "C:\FF7R2UProj\Tools\CreateACharacterSystemSetup\make_setup.py" --stub "C:\FF7R2UProj\Tools\CreateACharacterSystemSetup\Setup.stub.exe" --main-dll "%LATEST%\main.dll" --readme "%SC%\mod\README.txt" --example "%SC%\mod\compat\example.json.txt" --source "%SC%\src\RebirthSkelCompat.cpp" --plugin "C:\FF7R2UProj\Plugins\RebirthSkelCompat" --out-dir "C:\FF7R2UProj\Tools\Share" > "%~dp0build\install_setup.log" 2>&1
if errorlevel 1 (
  echo    the Setup was not packed ^(build\install_setup.log^); the game mod is installed all the same>> "%STATUS%"
) else (
  echo    Setup packed ^(Tools\Share\CreateACharacterSystem-Setup-3.7.0.exe^)>> "%STATUS%"
)
echo ALL DONE: start the game. In battle Vincent is a shooter: R2 fire, L2 aim, R1 reload, L1 switch gun, R3 zoom while aiming; Square is his melee combo. After a fight send Sandalphon ue4ss\Mods\RebirthSkelCompat\RebirthSkelCompat.log>> "%STATUS%"
goto :done

:nomods
echo STOPPED: the game's ~mods folder has no %VP%; nothing was changed>> "%STATUS%"
goto :done

:nocompat
echo STOPPED: the Create a Character System's compat folder is not there; nothing was changed>> "%STATUS%"
goto :done

:nosource
echo STOPPED: Tools\RebirthSkelCompat has no build_dll.py; nothing was changed>> "%STATUS%"
goto :done

:badstage
echo STOPPED: a staged file in Tools\_stage\shooter1016 is not the one made for this ^(see above^); nothing was changed: tell Sandalphon>> "%STATUS%"
goto :done

:otherpak
echo STOPPED: %VP% in ~mods is not the one this was made on; nothing was changed: tell Sandalphon>> "%STATUS%"
goto :done

:badbackup
echo STOPPED: the backup of %VP% did not check out ^(Tools\_backup\shooter1016\mods^); nothing else was changed>> "%STATUS%"
goto :done

:badpak
echo FAILED: %VP% in ~mods did not check out; putting the old one back from Tools\_backup\shooter1016\mods>> "%STATUS%"
for %%E in (ucas utoc pak) do copy /y "%BACKUP%\mods\%VP%.%%E" "%MODS%\%VP%.%%E" >nul
goto :done

:badpak2
echo FAILED: VincentDirgeMotions_P or VincentChaos_P in ~mods did not check out ^(see above^): run this again>> "%STATUS%"
goto :done

:badjson
echo FAILED: a compat file or a picture did not check out ^(the paks are installed^): run this again>> "%STATUS%"
goto :done

:badsource
echo FAILED: the 3.7.0 source did not copy into Tools\RebirthSkelCompat ^(see above^); the paks, compat files and pictures are installed, 3.6.16 stays: run this again>> "%STATUS%"
goto :done

:badbuild
echo FAILED: the game mod did not build ^(build\install_dll.log^); the paks, compat files and pictures are installed, 3.6.16 stays: tell Sandalphon>> "%STATUS%"
goto :done

:done
echo FINISHED %DATE% %TIME%>> "%STATUS%"
type "%STATUS%"
pause
exit /b

:md5
certutil -hashfile "%~1" MD5 2>nul | findstr /i /c:"%~2" >nul
if not errorlevel 1 exit /b 0
echo    %~nx1 is not the expected file ^(md5 should be %~2^)>> "%STATUS%"
exit /b 1

:quietmd5
certutil -hashfile "%~1" MD5 2>nul | findstr /i /c:"%~2" >nul
if not errorlevel 1 exit /b 0
exit /b 1

:pictures
call :md5 "%~1\bullet_icon.png" 9ce5f0a2ab943c6b74acc1d6ad047090 || exit /b 1
call :md5 "%~1\counter_frame.png" dee2c7c6a72540a1e09da717c15fda8e || exit /b 1
call :md5 "%~1\digit_0.png" 8f52355e427ae8386dc46cb2e2cfcc58 || exit /b 1
call :md5 "%~1\digit_1.png" 423325d57252cfe3cd9418fe807954bb || exit /b 1
call :md5 "%~1\digit_2.png" 81793967ace39c3ec24d271218059206 || exit /b 1
call :md5 "%~1\digit_3.png" 2019d4fb36dc38739775c08154c64971 || exit /b 1
call :md5 "%~1\digit_4.png" 68147f82ab3148a995ae933b2d8de361 || exit /b 1
call :md5 "%~1\digit_5.png" ee5dadbef9373f0f89875e6dba68c519 || exit /b 1
call :md5 "%~1\digit_6.png" 7d4325119f98dfbed60d6a8af42ce50d || exit /b 1
call :md5 "%~1\digit_7.png" 7ab28ccb56c3cdc6e5bb03844c982647 || exit /b 1
call :md5 "%~1\digit_8.png" e7619c42085b2d883a3eb965d26ab6c8 || exit /b 1
call :md5 "%~1\digit_9.png" f10b91757378999708412509661bf273 || exit /b 1
call :md5 "%~1\reticle_cross.png" 1aa9a3d3e8f58c309f215b3f2e5d26f9 || exit /b 1
call :md5 "%~1\reticle_ornate.png" 9d74378f6f2406b6c2c6dcebd6e28fd7 || exit /b 1
call :md5 "%~1\reticle_round.png" f34e193947cc7f11ca1a4a687ca85ab3 || exit /b 1
call :md5 "%~1\scope_ring.png" a2f475c41f598a576ba2af904b5f878d || exit /b 1
exit /b 0

:findpython
set "PY="
where py >nul 2>nul && set "PY=py -3"
if not defined PY if exist "%LOCALAPPDATA%\Programs\Python\Python399\python.exe" set "PY=%LOCALAPPDATA%\Programs\Python\Python399\python.exe"
if not defined PY set "PY=python"
exit /b
