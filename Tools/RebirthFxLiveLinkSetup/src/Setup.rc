// Rebirth FX Live Link Setup resources
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP ICON "../res/app.ico"
1 RT_MANIFEST "../res/Setup.manifest"

IDD_MAIN DIALOGEX 0, 0, 340, 286
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Rebirth FX Live Link Setup"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Rebirth FX Live Link", IDC_TITLE, 12, 8, 316, 16
    LTEXT           "", IDC_SUBTITLE, 12, 26, 316, 18
    AUTOCHECKBOX    "Game mod (UE4SS): plays and live-edits the effects in the running game", IDC_GAME_CHECK, 12, 50, 316, 10
    LTEXT           "FINAL FANTASY VII REBIRTH folder:", IDC_GAME_LABEL, 24, 63, 250, 8
    COMBOBOX        IDC_GAME_PATH, 24, 73, 250, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_GAME_BROWSE, 278, 72, 50, 14
    LTEXT           "", IDC_GAME_STATUS, 24, 89, 304, 26
    AUTOCHECKBOX    "Editor plugin: the Rebirth FX menu in your End project", IDC_PLUGIN_CHECK, 12, 118, 316, 10
    LTEXT           "End project (End.uproject):", IDC_PROJECT_LABEL, 24, 131, 250, 8
    COMBOBOX        IDC_PROJECT_PATH, 24, 141, 250, 150, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Browse...", IDC_PROJECT_BROWSE, 278, 140, 50, 14
    LTEXT           "", IDC_PROJECT_STATUS, 24, 157, 304, 26
    EDITTEXT        IDC_LOG, 12, 188, 316, 68, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    PUSHBUTTON      "Read Me", IDC_README, 12, 264, 54, 14
    PUSHBUTTON      "Uninstall", IDC_UNINSTALL, 70, 264, 54, 14
    DEFPUSHBUTTON   "Install", IDOK, 220, 264, 52, 14
    PUSHBUTTON      "Close", IDCANCEL, 276, 264, 52, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SETUP_STUB_VERSION_RC
 PRODUCTVERSION SETUP_STUB_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Kade"
            VALUE "FileDescription", "Rebirth FX Live Link Setup"
            VALUE "FileVersion", SETUP_STUB_VERSION_TEXT
            VALUE "InternalName", "RebirthFxLiveLink-Setup"
            VALUE "OriginalFilename", "RebirthFxLiveLink-Setup.exe"
            VALUE "ProductName", "Rebirth FX Live Link"
            VALUE "ProductVersion", SETUP_STUB_VERSION_TEXT
            VALUE "Comments", "Installs the Rebirth FX Live Link editor plugin (the Rebirth FX menu) and its UE4SS mod for FINAL FANTASY VII REBIRTH. Uses puff (c) Mark Adler, zlib license."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
